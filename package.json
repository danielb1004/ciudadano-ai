{
  "name": "ciudadano-ai",
  "private": true,
  "workspaces": [
    "frontend",
    "shared",
    "services/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --coverage && npm run test --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
