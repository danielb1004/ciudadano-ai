FROM python:3.12-slim
WORKDIR /workspace
COPY services/nlp-service/requirements.txt services/nlp-service/requirements.txt
COPY ml/requirements-training.txt ml/requirements-training.txt
RUN pip install --no-cache-dir torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r ml/requirements-training.txt
COPY services/nlp-service/app /app/app
WORKDIR /app
ENV NLP_BACKEND=beto BETO_MODEL_PATH=/models/beto-intents-v1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
