FROM python:3.12-slim
WORKDIR /app
COPY services/nlp-service/requirements.txt services/nlp-service/requirements-runtime.txt ./
RUN python -m pip install --no-cache-dir --upgrade "pip>=26.2" && python -m pip install --no-cache-dir -r requirements-runtime.txt
COPY services/nlp-service/app ./app
ENV NLP_BACKEND=beto BETO_RUNTIME=onnx BETO_MODEL_PATH=/models/beto-synthetic-v1 NLP_CPU_THREADS=2
EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
