          </HeaderManager>
          <hashTree />
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP success" enabled="true">
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <intProp name="Assertion.test_type">2</intProp>
            <collectionProp name="Asserion.test_strings">
              <stringProp name="0">^20[01]$</stringProp>
